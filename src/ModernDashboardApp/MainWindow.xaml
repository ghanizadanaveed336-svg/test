<Window x:Class="ModernDashboardApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulseBoard"
        Height="860" Width="1440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#121D31"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="BorderBrush" Value="#23354F"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TinyBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#1C2A42"/>
        </Style>
    </Window.Resources>

    <Border Background="#0B1120" CornerRadius="30" BorderBrush="#1A2940" BorderThickness="1" Margin="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2" Background="#0F172A" BorderBrush="#1A2940" BorderThickness="0,0,0,1" MouseLeftButtonDown="Border_MouseLeftButtonDown">
                <Grid Margin="20,14,20,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="12" Background="#7C6AFC">
                            <TextBlock Text="P" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="PulseBoard" Margin="12,0,0,0" FontSize="24" FontWeight="Bold" Foreground="#E5EEF9" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="1" Height="42" Width="350" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" Background="#111B2D" BorderBrush="#23354F" BorderThickness="1">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⌕" FontSize="18" Foreground="#9FB3C8" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#E5EEF9" VerticalContentAlignment="Center" Text="Search projects, tasks..." Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="20" Background="#1A2940" Margin="0,0,12,0">
                            <TextBlock Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="42" Height="42" CornerRadius="21" Background="#38BDF8" BorderBrush="#0F172A" BorderThickness="2">
                            <TextBlock Text="AD" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="20,20,0,20" Style="{StaticResource PanelStyle}">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Workspace" Foreground="#9FB3C8" FontSize="12" FontWeight="SemiBold" TextTransform="Uppercase"/>
                        <TextBlock Text="Product Team" Margin="0,10,0,0" Foreground="#E5EEF9" FontSize="30" FontWeight="Bold"/>
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,24,0,0" Style="{StaticResource TinyBadge}">
                        <TextBlock Text="Active sprint • 14 days left" Foreground="#E5EEF9" FontWeight="SemiBold"/>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,26,0,0">
                        <TextBlock Text="Navigation" Foreground="#9FB3C8" FontSize="12" FontWeight="SemiBold" TextTransform="Uppercase" Margin="0,0,0,14"/>
                        <TextBlock Text="Dashboard" Foreground="#E5EEF9" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                        <TextBlock Text="Projects" Foreground="#9FB3C8" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                        <TextBlock Text="Calendar" Foreground="#9FB3C8" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                        <TextBlock Text="Reports" Foreground="#9FB3C8" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                        <TextBlock Text="Settings" Foreground="#9FB3C8" FontWeight="SemiBold" FontSize="16"/>
                    </StackPanel>

                    <Border Grid.Row="3" Margin="0,28,0,0" CornerRadius="18" Background="#0E1A2C" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Team health" Foreground="#E5EEF9" FontSize="18" FontWeight="SemiBold"/>
                            <ProgressBar Grid.Row="1" Margin="0,18,0,0" Height="10" Value="82" Maximum="100" Foreground="#34D399" Background="#23354F" />
                            <TextBlock Grid.Row="1" Margin="0,30,0,0" Text="82% productive" Foreground="#9FB3C8"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Grid.Row="1" Margin="18,20,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Margin="0,0,12,0" Style="{StaticResource PanelStyle}" Padding="20">
                        <Grid>
                            <TextBlock Text="Total tasks" Foreground="#9FB3C8" FontSize="13"/>
                            <TextBlock Text="{Binding TotalTasks}" Foreground="#E5EEF9" FontSize="32" FontWeight="Bold" Margin="0,26,0,0"/>
                            <TextBlock Text="+12% from last week" Foreground="#34D399" Margin="0,60,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Margin="0,0,12,0" Style="{StaticResource PanelStyle}" Padding="20">
                        <Grid>
                            <TextBlock Text="Completed" Foreground="#9FB3C8" FontSize="13"/>
                            <TextBlock Text="{Binding CompletedTasks}" Foreground="#E5EEF9" FontSize="32" FontWeight="Bold" Margin="0,26,0,0"/>
                            <TextBlock Text="+8 this sprint" Foreground="#38BDF8" Margin="0,60,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Margin="0,0,12,0" Style="{StaticResource PanelStyle}" Padding="20">
                        <Grid>
                            <TextBlock Text="On track" Foreground="#9FB3C8" FontSize="13"/>
                            <TextBlock Text="{Binding OnTrack}" Foreground="#E5EEF9" FontSize="32" FontWeight="Bold" Margin="0,26,0,0"/>
                            <TextBlock Text="94% delivery" Foreground="#FBBF24" Margin="0,60,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource PanelStyle}" Padding="20">
                        <Grid>
                            <TextBlock Text="Risk" Foreground="#9FB3C8" FontSize="13"/>
                            <TextBlock Text="{Binding RiskCount}" Foreground="#E5EEF9" FontSize="32" FontWeight="Bold" Margin="0,26,0,0"/>
                            <TextBlock Text="2 critical items" Foreground="#F87171" Margin="0,60,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PanelStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Current sprint" Foreground="#E5EEF9" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Q4 • 2026" Foreground="#9FB3C8" VerticalAlignment="Center"/>
                            </Grid>

                            <ListBox Grid.Row="1" ItemsSource="{Binding Tasks}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12" Padding="16" CornerRadius="18" Background="#0E1A2C" BorderBrush="#23354F" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding AccentBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Category}" Foreground="#9FB3C8" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="#E5EEF9" FontSize="18" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding DueDate}" Foreground="#9FB3C8" Margin="0,8,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <Border CornerRadius="12" Padding="8,4" Background="#1C2A42">
                                                        <TextBlock Text="{Binding Status}" Foreground="#E5EEF9" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <ProgressBar Width="120" Height="8" Margin="0,12,0,0" Value="{Binding Progress}" Maximum="100" Foreground="{Binding AccentBrush}" Background="#23354F"/>
                                                    <TextBlock Text="{Binding Progress}%" Foreground="#9FB3C8" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Margin="18,0,0,0" Style="{StaticResource PanelStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Today focus" Foreground="#E5EEF9" FontSize="22" FontWeight="Bold"/>

                            <Border Grid.Row="1" Margin="0,18,0,0" Padding="16" Background="#0E1A2C" CornerRadius="18">
                                <StackPanel>
                                    <TextBlock Text="Sprint review" Foreground="#E5EEF9" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="12:30 PM • Team sync" Foreground="#9FB3C8" Margin="0,8,0,0"/>
                                    <Border Margin="0,16,0,0" Padding="10,6" CornerRadius="12" Background="#1C2A42" HorizontalAlignment="Left">
                                        <TextBlock Text="High priority" Foreground="#FBBF24" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="2" Margin="0,24,0,0">
                                <TextBlock Text="Team activity" Foreground="#E5EEF9" FontSize="18" FontWeight="SemiBold"/>
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="• Maya completed onboarding flow" Foreground="#9FB3C8" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Lucas updated API contract" Foreground="#9FB3C8" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Sarah fixed QA regression" Foreground="#9FB3C8" Margin="0,0,0,8"/>
                                    <TextBlock Text="• 4 blockers resolved today" Foreground="#9FB3C8"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
